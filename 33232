    async def _get_ticket_context(self, interaction: discord.Interaction):
        channel = interaction.channel
        entry = get_ticket_entry(channel.id)
        if entry is None:
            return None

        creator_id   = entry.get("creator_id")
        category_key = entry.get("category_key")
        claimed_by   = entry.get("claimed_by")

        creator = interaction.guild.get_member(creator_id)
        if creator is None:
            try:
                creator = await interaction.guild.fetch_member(creator_id)
            except Exception:
                creator = None

        return channel, creator, creator_id, category_key, claimed_by

    async def open_settings(self, interaction: discord.Interaction):
        if not _is_staff(interaction.user):
            await interaction.response.send_message(
                f"{BULLET_EMOJI}︲Tylko administracja ma dostęp do ustawień ticketa.", ephemeral=True
            )
            return
        await interaction.response.send_message(view=TicketSettingsView(), ephemeral=True)

    async def close_ticket(self, interaction: discord.Interaction):
        ctx = await self._get_ticket_context(interaction)
        if ctx is None:
            await interaction.response.send_message(
                f"{BULLET_EMOJI}︲Ten kanał nie jest zarejestrowany jako ticket.", ephemeral=True
            )
            return
        channel, creator, creator_id, category_key, claimed_by = ctx

        if interaction.user.id != creator_id and not _is_staff(interaction.user):
            await interaction.response.send_message(
                f"{BULLET_EMOJI}︲Tylko twórca ticketa lub administracja może go zamknąć.", ephemeral=True
            )
            return

        await interaction.response.defer(ephemeral=True)

        warnings: list[str] = []
        current_time = datetime.datetime.now().strftime('%d.%m.%Y %H:%M')

        try:
            messages = [m async for m in channel.history(limit=None, oldest_first=True)]
        except Exception as e:
            await interaction.followup.send(
                f"{BULLET_EMOJI}︲Błąd przy pobieraniu historii wiadomości: `{e}`", ephemeral=True
            )
            return

        category_label = TICKET_CATEGORIES.get(category_key, {}).get('label', 'Nieznana kategoria')

        try:
            html_content = generate_html_transcript(
                channel.name, channel.id, creator or _mention(creator_id),
                category_label, messages, current_time
            )

            txt_content = (
                f"```💜︲LEANARTS.PL × TRANSKRYPT TICKETA```\n"
                f"Kanał: #{channel.name}\nID: {channel.id}\n"
                f"Twórca: {creator if creator else _mention(creator_id)} ({creator_id})\n"
                f"Kategoria: {category_label}\n"
                f"Data zamknięcia: {current_time}\n\n"
            )
            for msg in messages:
                ts = msg.created_at.strftime('%d.%m.%Y %H:%M:%S')
                txt_content += f"[{ts}] {msg.author.name}: {msg.content}\n"
                for att in msg.attachments:
                    txt_content += f"  📎 {att.filename} ({att.url})\n"
                txt_content += "\n"
        except Exception as e:
            await interaction.followup.send(
                f"{BULLET_EMOJI}︲Błąd generowania transkryptu: `{e}`", ephemeral=True
            )
            return

        html_fname = f"ticket_{channel.id}_{current_time.replace(':', '-').replace(' ', '_')}.html"
        txt_fname  = html_fname.replace('.html', '.txt')

        html_bytes = html_content.encode('utf-8')
        txt_bytes  = txt_content.encode('utf-8')

        def _files():
            return [
                discord.File(io.BytesIO(html_bytes), filename=html_fname),
                discord.File(io.BytesIO(txt_bytes), filename=txt_fname)
            ]

        transcripts_channel = interaction.client.get_channel(TRANSCRIPTS_CHANNEL_ID)
        if transcripts_channel:
            tr_body = (
                f"{BULLET_EMOJI}︲Ticket został zamknięty.\n"
                f"{BULLET_EMOJI}︲Twórca: {creator.mention if creator else _mention(creator_id)}\n"
                f"{BULLET_EMOJI}︲Kategoria: **{category_label}**\n"
                f"{BULLET_EMOJI}︲ID Ticketa: `{channel.id}`\n"
                f"{BULLET_EMOJI}︲Data: `{current_time}`"
            )
            if claimed_by:
                tr_body += f"\n{BULLET_EMOJI}︲Przejęty przez: {_mention(claimed_by)}"
            try:
                await transcripts_channel.send(
                    view=_make_layout_view(TRANSCRIPT_MARKER, tr_body, file_names=[html_fname, txt_fname]),
                    files=_files()
                )
            except Exception as e:
                warnings.append(f"Nie udało się wysłać transkryptu na kanał: `{e}`")

        if creator:
            try:
                dm_body = (
                    f"{BULLET_EMOJI}︲Twój ticket został zamknięty.\n"
                    f"{BULLET_EMOJI}︲Kategoria: **{category_label}**\n"
                    f"{BULLET_EMOJI}︲ID Ticketa: `{channel.id}`\n"
                    f"{BULLET_EMOJI}︲Data zamknięcia: `{current_time}`\n\n"
                    f"{BULLET_EMOJI}︲Poniżej znajduje się transkrypt Twojej rozmowy."
                )
                await creator.send(
                    view=_make_layout_view(DM_MARKER, dm_body, file_names=[html_fname, txt_fname]),
                    files=_files()
                )
            except discord.Forbidden:
                warnings.append(f"Nie można wysłać PV do {creator.mention} (zablokowane DM)")
            except Exception as e:
                warnings.append(f"Błąd wysyłania DM: `{e}`")

        logs_channel = interaction.client.get_channel(LOGS_CHANNEL_ID)
        if logs_channel:
            log_body = (
                f"{BULLET_EMOJI}︲Zamknięcie ticketa:\n"
                f"{BULLET_EMOJI}︲Zamknął: {interaction.user.mention} (`{interaction.user.id}`)\n"
                f"{BULLET_EMOJI}︲Twórca: {creator.mention if creator else _mention(creator_id)}\n"
                f"{BULLET_EMOJI}︲Kategoria: **{category_label}**\n"
                f"{BULLET_EMOJI}︲ID Ticketa: `{channel.id}`"
            )
            try:
                await logs_channel.send(view=_make_layout_view(LOG_MARKER, log_body))
            except Exception as e:
                warnings.append(f"Błąd przy wysyłaniu logu: `{e}`")

        if warnings:
            await interaction.followup.send(
                f"{BULLET_EMOJI}︲Ticket zostaje zamknięty, uwaga:\n" + "\n".join(f"> {w}" for w in warnings),
                ephemeral=True
            )
        else:
            await interaction.followup.send(
                f"{BULLET_EMOJI}︲Ticket zamknięty! Kanał zostanie usunięty za 5 sekund.", ephemeral=True
            )

        await _set_channel_status(channel, STATUS_CLOSED)
        await asyncio.sleep(5)
        try:
            await channel.delete(reason="Zamknięty ticket")
            delete_ticket_entry(channel.id)
            log_success(f"Ticket zamknięty: {channel.name}")
        except discord.Forbidden:
            log_error(f"Nie można usunąć kanału {channel.name}")

    async def callout_ticket(self, interaction: discord.Interaction):
        await trigger_callout(interaction)

    async def takeover_ticket(self, interaction: discord.Interaction):
        if not _is_staff(interaction.user):
            await interaction.response.send_message(
                f"{BULLET_EMOJI}︲Tylko administracja może przejąć ticket.", ephemeral=True
            )
            return

        ctx = await self._get_ticket_context(interaction)
        if ctx is None:
            await interaction.response.send_message(
                f"{BULLET_EMOJI}︲Kanał nie jest zarejestrowany jako ticket.", ephemeral=True
            )
            return
        channel, old_creator, old_creator_id, category_key, _prev_claimed_by = ctx

        await interaction.response.defer(ephemeral=True)

        current_time = datetime.datetime.now().strftime('%d.%m.%Y %H:%M')
        category_label = TICKET_CATEGORIES.get(category_key, {}).get('label', 'Nieznana kategoria')

        try:
            if old_creator:
                await channel.set_permissions(old_creator, read_messages=True, send_messages=True)
            await channel.set_permissions(interaction.user, read_messages=True, send_messages=True)
            await _set_channel_status(channel, STATUS_ACTIVE)

            claim_ticket_entry(channel.id, interaction.user.id)

            takeover_body = (
                f"{BULLET_EMOJI}︲Ticket został przejęty przez członka zespołu!\n"
                f"{BULLET_EMOJI}︲Twórca: {old_creator.mention if old_creator else _mention(old_creator_id)}\n"
                f"{BULLET_EMOJI}︲Opiekun: {interaction.user.mention}\n"
                f"{BULLET_EMOJI}︲Czas przejęcia: `{current_time}`"
            )
            await channel.send(view=_make_layout_view(TAKEOVER_MARKER, takeover_body))

            await interaction.followup.send(
                f"{BULLET_EMOJI}︲Przejęto ticket! Jesteś nowym opiekunem.", ephemeral=True
            )

            logs_channel = interaction.client.get_channel(LOGS_CHANNEL_ID)
            if logs_channel:
                log_body = (
                    f"{BULLET_EMOJI}︲Przejęcie ticketa:\n"
                    f"{BULLET_EMOJI}︲Administrator: {interaction.user.mention} (`{interaction.user.id}`)\n"
                    f"{BULLET_EMOJI}︲Twórca: {old_creator.mention if old_creator else _mention(old_creator_id)}\n"
                    f"{BULLET_EMOJI}︲Kategoria: **{category_label}**\n"
                    f"{BULLET_EMOJI}︲ID Ticketa: `{channel.id}`"
                )
                await logs_channel.send(view=_make_layout_view(LOG_MARKER, log_body))

            log_success(f"Ticket {channel.name} przejęty przez {interaction.user}")

        except discord.Forbidden:
            await interaction.followup.send(
                f"{BULLET_EMOJI}︲Brak uprawnień do zmiany uprawnień kanału.", ephemeral=True
            )
        except Exception as e:
            log_error(f"Błąd przy przejmowaniu ticketa: {e}")

