class TicketQuestionModal(discord.ui.Modal):
    def __init__(self, guild: discord.Guild, category_key: str, category: dict):
        self.guild        = guild
        self.category_key = category_key
        self.category     = category
        super().__init__(title=f"Formularz: {category['label']}", timeout=300)

        for idx, (question, placeholder) in enumerate(category['questions'][:5]):
            self.add_item(discord.ui.TextInput(
                label=question,
                placeholder=placeholder,
                style=discord.TextStyle.paragraph if idx == len(category['questions'])-1 else discord.TextStyle.short,
                required=True,
                custom_id=f"question_{idx}"
            ))

    async def on_submit(self, interaction: discord.Interaction):
        answers = {}
        for idx, (question, _) in enumerate(self.category['questions'][:5]):
            try:
                answers[question] = self.children[idx].value
            except Exception:
                pass

        user         = interaction.user
        channel_name = f"🟠︲{self.category['channel_prefix']}-{user.name.lower()[:15]}"

        overwrites = {
            self.guild.default_role: discord.PermissionOverwrite(read_messages=False),
            user:                    discord.PermissionOverwrite(read_messages=True, send_messages=True),
            self.guild.me:           discord.PermissionOverwrite(read_messages=True, send_messages=True)
        }

        staff_found = False
        for role_id in STAFF_ROLE_IDS:
            role = self.guild.get_role(role_id)
            if role:
                overwrites[role] = discord.PermissionOverwrite(read_messages=True, send_messages=True)
                staff_found = True
        if not staff_found:
            log_error("Nie odnaleziono zdefiniowanych rang Staffu w gildii!")

        category_channel = self.guild.get_channel(TICKET_CATEGORY_ID)

        try:
            channel = await self.guild.create_text_channel(
                name=channel_name,
                overwrites=overwrites,
                category=category_channel if isinstance(category_channel, discord.CategoryChannel) else None,
                reason=f"Ticket od {user.name}"
            )

            set_ticket_entry(channel.id, user.id, self.category_key)

            body_text = (
                f"{user.mention}\n\n"
                f"{BULLET_EMOJI}︲Dziękujemy za otwarcie ticketa!\n"
                f"{BULLET_EMOJI}︲Kategoria: **{self.category['label']}**\n"
                f"{BULLET_EMOJI}︲Użytkownik: {user.mention}\n"
                f"{BULLET_EMOJI}︲ID Ticketa: `{channel.id}`\n\n"
                f"> **Twoje odpowiedzi w formularzu:**\n"
            )
            for question, answer in answers.items():
                body_text += f"{BULLET_EMOJI}︲**{question}**\n```{answer}```\n"

            body_text += (
                f"\n> **Informacje:**\n"
                f"{BULLET_EMOJI}︲⏱️ Czas odpowiedzi: 1-24h (zależy od obciążenia)\n"
                f"{BULLET_EMOJI}︲💰 Po zatwierdzeniu szczegółów podamy wycenę i metody płatności\n"
                f"{BULLET_EMOJI}︲✅ Zespół przeanalizuje Twoje zamówienie/sprawę\n\n"
                f"{BULLET_EMOJI}︲Użyj przycisków poniżej, aby zarządzać ticketem."
            )

            ticket_panel = TicketActionPanel(body_text)
            await channel.send(view=ticket_panel)

            await interaction.response.send_message(
                f"{BULLET_EMOJI}︲Ticket został pomyślnie utworzony!\n> Kanał: {channel.mention}",
                ephemeral=True
            )

            logs_channel = interaction.client.get_channel(LOGS_CHANNEL_ID)
            if logs_channel:
                log_body = (
                    f"{BULLET_EMOJI}︲Otwarcie nowego ticketa:\n"
                    f"{BULLET_EMOJI}︲Użytkownik: {user.mention} (`{user.id}`)\n"
                    f"{BULLET_EMOJI}︲Kategoria: **{self.category['label']}**\n"
                    f"{BULLET_EMOJI}︲Kanał: {channel.mention}\n"
                    f"{BULLET_EMOJI}︲ID Ticketa: `{channel.id}`"
                )
                await logs_channel.send(view=_make_layout_view(LOG_MARKER, log_body))

            log_success(f"Ticket utworzony: {channel.name} przez {user}")

        except discord.Forbidden:
            await interaction.response.send_message(
                f"{BULLET_EMOJI}︲Bot nie posiada uprawnień do tworzenia kanałów!", ephemeral=True
            )
            log_error("Brak uprawnień do tworzenia kanału")
        except Exception as e:
            log_error(f"Błąd przy tworzeniu ticketa: {e}")

