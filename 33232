def load_callout_cooldowns() -> dict:
    if os.path.exists(CALLOUT_COOLDOWN_FILE):
        try:
            with open(CALLOUT_COOLDOWN_FILE, "r", encoding="utf-8") as f:
                return json.load(f)
        except Exception:
            return {}
    return {}

def save_callout_cooldowns(data: dict) -> None:
    try:
        with open(CALLOUT_COOLDOWN_FILE, "w", encoding="utf-8") as f:
            json.dump(data, f, indent=4)
    except Exception as e:
        log_error(f"Błąd przy zapisie callout cooldown: {e}")

def _load_ticket_data() -> dict:
    if os.path.exists(TICKET_DATA_FILE):
        try:
            with open(TICKET_DATA_FILE, "r", encoding="utf-8") as f:
                return json.load(f)
        except Exception:
            return {}
    return {}

def _save_ticket_data(data: dict) -> None:
    try:
        with open(TICKET_DATA_FILE, "w", encoding="utf-8") as f:
            json.dump(data, f, indent=4)
    except Exception as e:
        log_error(f"Błąd przy zapisie danych ticketów: {e}")

def get_ticket_entry(channel_id: int) -> dict | None:
    return _load_ticket_data().get(str(channel_id))

def set_ticket_entry(channel_id: int, creator_id: int, category_key: str) -> None:
    data = _load_ticket_data()
    data[str(channel_id)] = {
        "creator_id": creator_id,
        "category_key": category_key,
        "claimed_by": None,
        "created_at": datetime.datetime.now().isoformat(),
    }
    _save_ticket_data(data)

def claim_ticket_entry(channel_id: int, staff_id: int) -> None:
    data = _load_ticket_data()
    key = str(channel_id)
    if key in data:
        data[key]["claimed_by"] = staff_id
        _save_ticket_data(data)

def delete_ticket_entry(channel_id: int) -> None:
    data = _load_ticket_data()
    if str(channel_id) in data:
        data.pop(str(channel_id))
        _save_ticket_data(data)

def _is_staff(member: discord.Member) -> bool:
    if member.guild_permissions.administrator:
        return True
    member_role_ids = {role.id for role in getattr(member, "roles", [])}
    return any(rid in member_role_ids for rid in STAFF_ROLE_IDS)

def _mention(user_id: int) -> str:
    return f"<@{user_id}>"

async def _set_channel_status(channel: discord.TextChannel, status: str) -> None:
    name = channel.name
    if "︲" in name:
        name = name.split("︲", 1)[1]
    new_name = f"{status}︲{name}"
    try:
        await channel.edit(name=new_name, reason=f"Status ticketa: {status}")
    except discord.Forbidden:
        log_error(f"Brak uprawnień do zmiany nazwy kanału {channel.name}")
    except discord.HTTPException as e:
        log_error(f"Błąd HTTP przy zmianie nazwy kanału: {e}")

def _make_layout_view(marker: str, body_text: str, file_names: list[str] | None = None) -> discord.ui.LayoutView:
    view = discord.ui.LayoutView(timeout=None)
    container = discord.ui.Container(accent_color=PANEL_COLOR)
    container.add_item(discord.ui.TextDisplay(f"```{marker}```"))
    container.add_item(discord.ui.TextDisplay(body_text))

    if file_names:
        container.add_item(discord.ui.Separator())
        for fname in file_names:
            container.add_item(discord.ui.File(media=f"attachment://{fname}"))

    if TICKET_BANNER_URL:
        container.add_item(discord.ui.Separator())
        container.add_item(discord.ui.MediaGallery(discord.MediaGalleryItem(TICKET_BANNER_URL)))

    container.add_item(discord.ui.Separator())
    container.add_item(discord.ui.TextDisplay(TICKET_COPYRIGHT))
    view.add_item(container)
    return view

