class Tickets(commands.Cog):
    def __init__(self, bot: commands.Bot):
        self.bot   = bot
        self.cache = self._load_cache()

    def _load_cache(self) -> dict:
        if os.path.exists(CACHE_FILE):
            try:
                with open(CACHE_FILE, "r", encoding="utf-8") as f:
                    return json.load(f)
            except Exception:
                return {}
        return {}

    def _save_cache(self) -> None:
        try:
            with open(CACHE_FILE, "w", encoding="utf-8") as f:
                json.dump(self.cache, f, indent=4)
        except Exception as e:
            log_error(f"Błąd przy zapisie cache: {e}")

    @commands.Cog.listener()
    async def on_ready(self):
        await self._send_or_update_panel()

    async def _send_or_update_panel(self):
        channel = self.bot.get_channel(PANEL_CHANNEL_ID)
        if channel is None:
            log_error(f"Nie znaleziono kanału panelu (ID: {PANEL_CHANNEL_ID})")
            return

        guild     = channel.guild
        view      = TicketDisplayView()
        cache_key = f"panel_{guild.id}"
        found_msg = None

        if cache_key in self.cache:
            try:
                found_msg = await channel.fetch_message(int(self.cache[cache_key]))
            except Exception:
                self.cache.pop(cache_key, None)

        if not found_msg:
            async for message in channel.history(limit=50):
                if message.author == self.bot.user and message.components:
                    found_msg = message
                    self.cache[cache_key] = str(message.id)
                    self._save_cache()
                    break

        if found_msg:
            await found_msg.edit(view=view)
        else:
            msg = await channel.send(view=view)
            self.cache[cache_key] = str(msg.id)
            self._save_cache()

    # Slash command /ustawienia
    @app_commands.command(name="ustawienia", description="Otwiera panel ustawień bieżącego ticketa.")
    async def ustawienia_cmd(self, interaction: discord.Interaction):
        entry = get_ticket_entry(interaction.channel.id)
        if not entry:
            await interaction.response.send_message(
                f"{BULLET_EMOJI}︲Ta komenda może być użyta tylko na kanale ticketa.", ephemeral=True
            )
            return

        if not _is_staff(interaction.user):
            await interaction.response.send_message(
                f"{BULLET_EMOJI}︲Nie masz uprawnień do zarządzania tym ticketem.", ephemeral=True
            )
            return

        await interaction.response.send_message(view=TicketSettingsView(), ephemeral=True)

    # Slash command /wezwij
    @app_commands.command(name="wezwij", description="Wezwij osobę, która utworzyła ten ticket.")
    async def wezwij_cmd(self, interaction: discord.Interaction):
        await trigger_callout(interaction)


async def setup(bot: commands.Bot):
    await bot.add_cog(Tickets(bot))
    bot.add_view(TicketDisplayView())
    bot.add_view(TicketActionPanel())
    bot.add_view(TicketSettingsView())
