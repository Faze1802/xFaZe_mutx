class AddUserModal(discord.ui.Modal, title="Dodaj użytkownika do ticketa"):
    user_input = discord.ui.TextInput(
        label="Nazwa użytkownika lub ID",
        placeholder="np. @username lub ID",
        custom_id="add_user_input"
    )

    def __init__(self, channel: discord.TextChannel):
        super().__init__()
        self.channel = channel

    async def on_submit(self, interaction: discord.Interaction):
        guild = self.channel.guild
        raw   = self.user_input.value.strip()
        user  = None
        try:
            user = await guild.fetch_member(int(raw)) if raw.isdigit() else \
                   discord.utils.find(lambda m: m.name == raw or m.display_name == raw, guild.members)
        except Exception:
            pass

        if not user:
            await interaction.response.send_message(
                f"{BULLET_EMOJI}︲Nie znaleziono użytkownika: `{raw}`", ephemeral=True
            )
            return

        try:
            await self.channel.set_permissions(user, read_messages=True, send_messages=True)
            await interaction.response.send_message(
                f"{BULLET_EMOJI}︲Użytkownik {user.mention} został dodany do ticketa!", ephemeral=True
            )
            await self.channel.send(
                f"{BULLET_EMOJI}︲{interaction.user.mention} dodał użytkownika {user.mention} do ticketa."
            )
        except discord.Forbidden:
            await interaction.response.send_message(
                f"{BULLET_EMOJI}︲Brak uprawnień do dodania użytkownika.", ephemeral=True
            )


