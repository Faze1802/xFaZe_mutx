        ".ma{font-weight:600;color:#c084fc}.mt{color:#71717a}.mc{color:#e4e4e7;line-height:1.5;word-wrap:break-word}"
        ".att{margin-top:8px;font-size:12px}.att a{color:#a855f7;text-decoration:none}"
        ".ftr{background:#111216;padding:14px 30px;text-align:center;font-size:12px;color:#71717a;border-top:1px solid #27272a}"
        "</style></head><body><div class='wrap'>"
        "<div class='hdr'><h1>💜 LEANARTS.PL — TRANSKRYPT TICKETA</h1>"
        f"<div class='meta'>"
        f"<div><strong>Kanał:</strong> #{channel_name}</div>"
