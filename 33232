class RenameChannelModal(discord.ui.Modal, title="Zmień nazwę kanału"):
    new_name_input = discord.ui.TextInput(
        label="Nowa nazwa kanału",
        placeholder="np. zamowienie-gotowe",
        custom_id="new_channel_name_input",
        required=True
    )

    def __init__(self, channel: discord.TextChannel):
        super().__init__()
        self.channel = channel

    async def on_submit(self, interaction: discord.Interaction):
        new_name = self.new_name_input.value.strip().lower().replace(" ", "-")
        try:
            await self.channel.edit(name=new_name, reason=f"Zmiana nazwy przez {interaction.user}")
            await interaction.response.send_message(
                f"{BULLET_EMOJI}︲Nazwa kanału została zmieniona na: `{new_name}`", ephemeral=True
            )
        except discord.Forbidden:
            await interaction.response.send_message(
                f"{BULLET_EMOJI}︲Brak uprawnień do zmiany nazwy kanału.", ephemeral=True
            )
        except Exception as e:
            await interaction.response.send_message(
                f"{BULLET_EMOJI}︲Błąd podczas zmiany nazwy: `{e}`", ephemeral=True
            )


