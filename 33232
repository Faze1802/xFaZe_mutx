async def trigger_callout(interaction: discord.Interaction):
    channel = interaction.channel
    entry = get_ticket_entry(channel.id)
    if entry is None:
        await interaction.response.send_message(
            f"{BULLET_EMOJI}︲Ten kanał nie jest zarejestrowany jako ticket.", ephemeral=True
        )
        return

    creator_id = entry.get("creator_id")
    creator = interaction.guild.get_member(creator_id)
    if creator is None:
        try:
            creator = await interaction.guild.fetch_member(creator_id)
        except Exception:
            creator = None

    if not _is_staff(interaction.user):
        await interaction.response.send_message(
            f"{BULLET_EMOJI}︲Tylko zespół wsparcia może wysyłać wezwania.", ephemeral=True
        )
        return

    if creator_id == interaction.user.id:
        await interaction.response.send_message(
            f"{BULLET_EMOJI}︲Nie możesz wezwać samego siebie.", ephemeral=True
        )
        return

    cooldowns  = load_callout_cooldowns()
    channel_id = str(channel.id)

    if channel_id in cooldowns:
        last_callout = datetime.datetime.fromisoformat(cooldowns[channel_id])
        next_callout = last_callout + datetime.timedelta(hours=24)
        if datetime.datetime.now() < next_callout:
            time_left = next_callout - datetime.datetime.now()
            hours, remainder = divmod(int(time_left.total_seconds()), 3600)
            minutes          = remainder // 60
            await interaction.response.send_message(
                f"{BULLET_EMOJI}︲Możesz ponownie wysłać wezwanie za **{hours}h {minutes}m**", ephemeral=True
            )
            return

    current_time          = datetime.datetime.now().strftime('%d.%m.%Y %H:%M')
    cooldowns[channel_id] = datetime.datetime.now().isoformat()
    save_callout_cooldowns(cooldowns)

    callout_body = (
        f"{BULLET_EMOJI}︲{interaction.user.mention} wezwał na ticket!\n"
        f"{BULLET_EMOJI}︲Czas: `{current_time}`\n"
        f"{BULLET_EMOJI}︲Prosimy o odpowiedź w kanale."
    )
    await channel.send(view=_make_layout_view(CALLOUT_MARKER, callout_body))

    if creator:
        try:
            dm_body = (
                f"{BULLET_EMOJI}︲Zostałeś wezwany na Twój ticket!\n"
                f"{BULLET_EMOJI}︲Kanał: #{channel.name}\n"
                f"{BULLET_EMOJI}︲Wezwał: {interaction.user.mention}\n"
                f"{BULLET_EMOJI}︲Czas: `{current_time}`\n\n"
                f"{BULLET_EMOJI}︲Kliknij aby przejść do kanału: {channel.mention}"
            )
            await creator.send(view=_make_layout_view(DM_CALLOUT_MARKER, dm_body))
        except discord.Forbidden:
            pass

    await interaction.response.send_message(
        f"{BULLET_EMOJI}︲Wezwanie zostało wysłane!", ephemeral=True
    )

